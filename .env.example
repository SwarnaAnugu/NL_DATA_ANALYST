# Copy this file to .env and fill in your real values.
# .env is gitignored — .env.example is committed so others know what's needed.

# Your Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Path to the SQLite database file the app will read from
DATABASE_PATH=data/ecommerce.db

# Which Claude model to call for SQL generation
CLAUDE_MODEL=claude-sonnet-5