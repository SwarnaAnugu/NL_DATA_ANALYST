# Copy this file to .env and fill in your real values.
# .env is gitignored — .env.example is committed so others know what's needed.

# Your Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Path to the SQLite database (relative to the repo root). If the file does not
# exist, the app unpacks demo_data/nl_data_analyst.db.xz into it on first start.
DATABASE_PATH=data/nl_data_analyst.db

# --- Optional ---
# NL_FAST_MODEL=claude-haiku-4-5     # scope / ambiguity / soundness checks
# NL_SMART_MODEL=claude-sonnet-4-6   # SQL generation, critique, explanation
# NL_SESSION_LIMIT=15                # questions per browser session (demo cost cap)
# NL_DAILY_LIMIT=300                 # questions per day across all visitors
